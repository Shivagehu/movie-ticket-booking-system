#include <iostream>
#include <string>
using namespace std;

enum class SeatType {
    SILVER,
    GOLD,
    PLATINUM
};

enum class SeatStatus {
    AVAILABLE,
    BOOKED
};

class Seat {
private:
    int number;
    SeatType type;

public:
    Seat(int number, SeatType type) {
        this->number = number;
        this->type = type;
    }

    int getNumber() const {
        return number;
    }

    SeatType getType() const {
        return type;
    }
};

class ShowSeat {
private:
    Seat seat;
    SeatStatus status;

public:
    ShowSeat(Seat seat) : seat(seat) {
        status = SeatStatus::AVAILABLE;
    }

    int getSeatNumber() const {
        return seat.getNumber();
    }

    SeatType getSeatType() const {
        return seat.getType();
    }

    bool isAvailable() const {
        return status == SeatStatus::AVAILABLE;
    }

    bool bookSeat() {
        if (!isAvailable())
            return false;

        status = SeatStatus::BOOKED;
        return true;
    }

    bool cancelSeat() {
        if (isAvailable())
            return false;

        status = SeatStatus::AVAILABLE;
        return true;
    }

    string getStatus() const {
        return isAvailable() ? "AVAILABLE" : "BOOKED";
    }
};
