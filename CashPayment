#include <iostream>
#include <string>
using namespace std;

class Payment {
public:
    virtual bool pay(double amount) = 0;

    virtual string getPaymentMethod() const = 0;

    virtual ~Payment() {}
};

class CashPayment : public Payment {
public:
    bool pay(double amount) override {

        cout << "\nCash received: Rs. "
             << amount << endl;

        return true;
    }

    string getPaymentMethod() const override {
        return "CASH";
    }
};
