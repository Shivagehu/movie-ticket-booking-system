#include <iostream>
#include <vector>
using namespace std;

enum class SeatType {
    SILVER,
    GOLD,
    PLATINUM
};

class ShowSeat {
public:
    virtual SeatType getSeatType() const = 0;

    virtual ~ShowSeat() {}
};

class PriceCalculator {
private:
    static constexpr double SILVER_PRICE = 150.0;
    static constexpr double GOLD_PRICE = 250.0;
    static constexpr double PLATINUM_PRICE = 400.0;

public:
    double calculate(
        const vector<ShowSeat*>& seats) const {

        double total = 0;

        for (ShowSeat* seat : seats) {

            if (seat->getSeatType()
                == SeatType::SILVER)

                total += SILVER_PRICE;

            else if (seat->getSeatType()
                     == SeatType::GOLD)

                total += GOLD_PRICE;

            else

                total += PLATINUM_PRICE;
        }

        return total;
    }
};
